def get_hypr_socket():
    xdg_runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if not sig:
        hypr_dir = os.path.join(xdg_runtime, "hypr")
        if os.path.isdir(hypr_dir):
            sigs = [d for d in os.listdir(hypr_dir) if os.path.exists(os.path.join(hypr_dir, d, ".socket.sock"))]
            if sigs:
                sigs.sort(key=lambda s: os.path.getmtime(os.path.join(hypr_dir, s)), reverse=True)
                sig = sigs[0]
                os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
    if sig:
        p = os.path.join(xdg_runtime, "hypr", sig, ".socket.sock")
        if os.path.exists(p):
            return p
    return None

def hypr_socket_request(cmd):
    p = get_hypr_socket()
    if not p:
        return None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(0.4)
        s.connect(p)
        payload = (cmd if cmd.endswith("\n") else cmd + "\n").encode("utf-8")
        s.sendall(payload)
        chunks = []
        while True:
            chunk = s.recv(8192)
            if not chunk:
                break
            chunks.append(chunk)
        s.close()
        return b"".join(chunks).decode("utf-8", errors="replace")
    except Exception:
        return None

def hypr_eval(lua_code):
    res = hypr_socket_request(f"eval {lua_code}")
    if res and res.strip().startswith("ok"):
        return True
    return False

def run_hyprctl(args):
    try:
        res = subprocess.run(["hyprctl"] + args, capture_output=True, text=True, timeout=2)
        return res.stdout
    except Exception:
        return ""

def get_devices():
    res = hypr_socket_request("j/devices")
    if res:
        try:
            return json.loads(res)
        except Exception:
            pass
    raw = run_hyprctl(["-j", "devices"])
    try:
        return json.loads(raw)
    except Exception:
        return {}

def is_real_keyboard(k):
    name = (k.get("name") or "").lower()
    ignore = ["avrcp", "video-bus", "power-button", "sleep-button", "hotkeys", "stream-deck", "consumer-control", "system-control"]
    return not any(ig in name for ig in ignore)

def get_primary_keyboard():
    devs = get_devices()
    kbs = devs.get("keyboards", [])
    if not kbs:
        return None
    real_kbs = [k for k in kbs if is_real_keyboard(k)]
    if not real_kbs:
        real_kbs = kbs
    kb = next((k for k in real_kbs if k.get("main")), None)
    if not kb:
        kb = next((k for k in real_kbs if "wooting" in k.get("name", "").lower()), None)
    if not kb:
        kb = next((k for k in real_kbs if "asus" in k.get("name", "").lower()), None)
    if not kb:
        kb = next((k for k in real_kbs if k.get("name") == "at-translated-set-2-keyboard"), None)
    if not kb:
        kb = next((k for k in real_kbs if k.get("layout")), real_kbs[0])
    return kb

def get_current_hotkey(options_str):
    opts = [o.strip() for o in (options_str or "").split(",") if o.strip()]
    grp_opt = next((o for o in opts if o.startswith("grp:")), "")
    for h in HOTKEYS:
        if h["option"] == grp_opt:
            return h
    if grp_opt:
        label = grp_opt.replace("grp:", "").replace("_toggle", "").replace("_", " ").title()
        return {"option": grp_opt, "label": label, "keys": [label]}
    return HOTKEYS[0]

def get_locales_info():
    user_lang = os.environ.get("LANG", "C.UTF-8")
    env_file = Path.home() / ".config/environment.d/10-locale.conf"
    if env_file.exists():
        try:
            for line in env_file.read_text().splitlines():
                if line.startswith("LANG="):
                    user_lang = line.split("=", 1)[1].strip().strip('"').strip("'")
                    break
        except Exception:
            pass

    sys_lang = user_lang
    try:
        out = subprocess.check_output(["localectl", "status"], text=True, timeout=1)
        for line in out.splitlines():
            if "System Locale:" in line and "LANG=" in line:
                sys_lang = line.split("LANG=", 1)[1].split()[0].strip()
                break
    except Exception:
        pass

    user_label = user_lang
    sys_label = sys_lang
    if HAVE_HYPRLAND_LANGUAGES:
        try:
            locs, _ = get_cached_locales_and_layouts()
            for l in locs:
                if l.code == user_lang or l.code.replace(".UTF-8", ".utf8") == user_lang:
                    user_label = l.display_name_es
                if l.code == sys_lang or l.code.replace(".UTF-8", ".utf8") == sys_lang:
                    sys_label = l.display_name_es
        except Exception:
            pass
    if user_label == user_lang:
        user_label = next((l["label"] for l in POPULAR_LOCALES if l["locale"] == user_lang), user_lang)
    if sys_label == sys_lang:
        sys_label = next((l["label"] for l in POPULAR_LOCALES if l["locale"] == sys_lang), sys_lang)

    return {
        "user_locale": user_lang,
        "user_locale_label": user_label,
        "system_locale": sys_lang,
        "system_locale_label": sys_label
    }

def get_status():
    kb = get_primary_keyboard()
    layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
    active_idx = kb.get("active_layout_index", 0) if kb else 0
    active_keymap = kb.get("active_keymap", "English (US)") if kb else "English (US)"
    options_raw = kb.get("options", "") if kb else ""

    layout_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]
    if not layout_codes:
        layout_codes = ["us"]

    layouts_list = []
    for idx, code in enumerate(layout_codes):
        label = LAYOUT_NAMES.get(code, code.upper())
        layouts_list.append({
            "id": idx,
            "code": code,
            "code_upper": code.upper()[:5],
            "label": label,
            "active": (idx == active_idx)
        })

    hotkey = get_current_hotkey(options_raw)
    loc_info = get_locales_info()

    return {
        "layouts": layouts_list,
        "active_index": active_idx,
        "active_code": (layout_codes[active_idx] if active_idx < len(layout_codes) else layout_codes[0]).upper(),
        "active_name": active_keymap,
        "current_hotkey": hotkey["label"],
        "current_hotkey_keys": hotkey["keys"],
        "hotkey_option": hotkey["option"],
        "available_hotkeys": HOTKEYS,
        "user_locale": loc_info["user_locale"],
        "user_locale_label": loc_info["user_locale_label"],
        "system_locale": loc_info["system_locale"],
        "system_locale_label": loc_info["system_locale_label"]
    }

def persist_hyprland_config(new_layouts_str=None, new_options_str=None):
    config_paths = [
        Path.home() / ".config/hypr/hyprland.lua",
        Path.home() / ".config/hypr/hyprland.conf",
        Path.home() / "hyprland/.config/hypr/hyprland.lua",
        Path.home() / "hyprland/.config/hypr/hyprland.conf",
    ]

    for p in config_paths:
        if not p.exists():
            continue
        try:
            content = p.read_text(encoding="utf-8")
            if p.suffix == ".lua":
                if new_layouts_str is not None:
                    content = re.sub(r'kb_layout\s*=\s*"[^"]*"', f'kb_layout = "{new_layouts_str}"', content)
                if new_options_str is not None:
                    content = re.sub(r'kb_options\s*=\s*"[^"]*"', f'kb_options = "{new_options_str}"', content)
            else:
                if new_layouts_str is not None:
                    content = re.sub(r'kb_layout\s*=\s*[^\n]*', f'kb_layout = {new_layouts_str}', content)
                if new_options_str is not None:
                    content = re.sub(r'kb_options\s*=\s*[^\n]*', f'kb_options = {new_options_str}', content)
            p.write_text(content, encoding="utf-8")
        except Exception:
            pass

def ensure_locale_generated(loc):
    clean = loc.lower().replace("-", "").replace(".", "").replace("_", "")
    try:
        out = subprocess.check_output(["locale", "-a"], text=True, timeout=2)
        for line in out.splitlines():
            cand = line.strip().lower().replace("-", "").replace(".", "").replace("_", "")
            if clean == cand or (clean.startswith(cand) and len(cand) >= 4) or (cand.startswith(clean) and len(clean) >= 4):
                return True
    except Exception:
        pass

    base = loc.split(".")[0].split("@")[0]
    charmap = "UTF-8" if "utf" in loc.lower() else "ISO-8859-1"
    try:
        subprocess.run(["sudo", "localedef", "-i", base, "-f", charmap, loc], timeout=5)
        return True
    except Exception:
        pass
    return False

def switch_layout(target):
    devs = get_devices()
    kbs = devs.get("keyboards", [])
    kb = get_primary_keyboard()
    layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
    layout_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]
    if not layout_codes:
        layout_codes = ["us"]

    target_idx = 0
    try:
        target_idx = int(target)
    except ValueError:
        target_code = target.strip().lower()
        if target_code in layout_codes:
            target_idx = layout_codes.index(target_code)

    if target_idx < 0 or target_idx >= len(layout_codes):
        target_idx = 0

    target_code = layout_codes[target_idx]

    # Switch every detected keyboard to target_idx
    for k in kbs:
        name = k.get("name")
        if name:
            run_hyprctl(["switchxkblayout", name, str(target_idx)])
    run_hyprctl(["switchxkblayout", "all", str(target_idx)])

    try:
        state_file = Path.home() / ".config/hypr/active_layout"
        state_file.write_text(target_code, encoding="utf-8")
    except Exception:
        pass

    notify_quickshell()
    print(json.dumps({"status": "switched", "index": target_idx, "code": target_code, "layouts": layout_codes}))

def switch_next():
    devs = get_devices()
    kbs = devs.get("keyboards", [])
    kb = get_primary_keyboard()
    layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
    layout_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]
    if not layout_codes:
        layout_codes = ["us"]

    cur_idx = kb.get("active_layout_index", 0) if kb else 0
    next_idx = (cur_idx + 1) % len(layout_codes)
    next_code = layout_codes[next_idx]

    for k in kbs:
        name = k.get("name")
        if name:
            run_hyprctl(["switchxkblayout", name, str(next_idx)])
    run_hyprctl(["switchxkblayout", "all", str(next_idx)])

    try:
        state_file = Path.home() / ".config/hypr/active_layout"
        state_file.write_text(next_code, encoding="utf-8")
    except Exception:
        pass

    notify_quickshell()
    print(json.dumps({"status": "switched", "index": next_idx, "code": next_code, "layouts": layout_codes}))

def restore_layout():
    try:
        state_file = Path.home() / ".config/hypr/active_layout"
        if state_file.exists():
            target_code = state_file.read_text(encoding="utf-8").strip().lower()
            if target_code:
                switch_layout(target_code)
                return
    except Exception:
        pass
    switch_layout(0)

def add_layout(code):
    clean_code = code.strip().lower()
    if not clean_code:
        print(json.dumps({"status": "error", "message": "empty layout code"}))
        return

    kb = get_primary_keyboard()
    layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
    layout_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]

    if clean_code in layout_codes:
        print(json.dumps({"status": "already_present", "layouts": layout_codes}))
        return

    layout_codes.append(clean_code)
    new_layouts_str = ",".join(layout_codes)

    hypr_eval(f'hl.config({{ input = {{ kb_layout = "{new_layouts_str}" }} }})')
    persist_hyprland_config(new_layouts_str=new_layouts_str)
    notify_quickshell()
    print(json.dumps({"status": "added", "code": clean_code, "layouts": layout_codes}))

def remove_layout(target):
    devs = get_devices()
    kbs = devs.get("keyboards", [])
    kb = get_primary_keyboard()
    layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
    layout_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]

    if len(layout_codes) <= 1:
        print(json.dumps({"status": "error", "message": "cannot remove last remaining layout"}))
        return

    target_code = None
    try:
        idx = int(target)
        if 0 <= idx < len(layout_codes):
            target_code = layout_codes[idx]
    except ValueError:
        target_code = target.strip().lower()

    if target_code and target_code in layout_codes:
        layout_codes.remove(target_code)
        new_layouts_str = ",".join(layout_codes)
        hypr_eval(f'hl.config({{ input = {{ kb_layout = "{new_layouts_str}" }} }})')
        persist_hyprland_config(new_layouts_str=new_layouts_str)
        for k in kbs:
            name = k.get("name")
            if name:
                run_hyprctl(["switchxkblayout", name, "0"])
        run_hyprctl(["switchxkblayout", "all", "0"])
        notify_quickshell()
        print(json.dumps({"status": "removed", "code": target_code, "layouts": layout_codes}))
    else:
        print(json.dumps({"status": "error", "message": "layout not found"}))

def set_hotkey(option):
    clean_option = option.strip()
    kb = get_primary_keyboard()
    curr_opts = (kb.get("options", "") if kb else "") or ""
    other = [o for o in curr_opts.split(",") if o and not o.startswith("grp:")]
    new_opts = ",".join(other + ([clean_option] if clean_option else []))

    hypr_eval(f'hl.config({{ input = {{ kb_options = "{new_opts}" }} }})')
    persist_hyprland_config(new_options_str=new_opts)
    notify_quickshell()
    print(json.dumps({"status": "hotkey_updated", "option": clean_option}))

def set_user_locale(loc):
    clean_loc = loc.strip()
    if not clean_loc:
        return
    if not clean_loc.endswith(".UTF-8") and not clean_loc.endswith(".utf8") and clean_loc != "C":
        clean_loc = f"{clean_loc}.UTF-8"

    ensure_locale_generated(clean_loc)

    env_dir = Path.home() / ".config/environment.d"
    env_dir.mkdir(parents=True, exist_ok=True)
    env_file = env_dir / "10-locale.conf"
    env_file.write_text(f'LANG="{clean_loc}"\nLC_MESSAGES="{clean_loc}"\n', encoding="utf-8")

    try:
        profile_file = Path.home() / ".profile"
        content = profile_file.read_text(encoding="utf-8") if profile_file.exists() else ""
        lines = [l for l in content.splitlines() if not l.startswith("export LANG=") and not l.startswith("export LC_MESSAGES=")]
        lines.append(f'export LANG="{clean_loc}"')
        lines.append(f'export LC_MESSAGES="{clean_loc}"')
        profile_file.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except Exception:
        pass

    # Save to rhythm and omarchy language files
    lang_code = clean_loc.split("_")[0].split(".")[0].lower()
    for cfg_dir in [Path.home() / ".config/rhythm", Path.home() / ".config/omarchy"]:
        try:
            cfg_dir.mkdir(parents=True, exist_ok=True)
            (cfg_dir / "language").write_text(f"{lang_code}\n", encoding="utf-8")
        except Exception:
            pass

    uwsm_dir = Path.home() / ".config/uwsm/env.d"
    try:
        uwsm_dir.mkdir(parents=True, exist_ok=True)
        (uwsm_dir / "50-rhythm-language").write_text(f'export LANG="{clean_loc}"\nexport LC_MESSAGES="{clean_loc}"\n', encoding="utf-8")
    except Exception:
        pass

    hypr_eval(f'hl.env("LANG", "{clean_loc}", true)')
    try:
        subprocess.run(["hyprctl", "setenv", "LANG", clean_loc], capture_output=True, timeout=1)
    except Exception:
        pass

    try:
        label = next((l["label"] for l in POPULAR_LOCALES if l["locale"] == clean_loc), clean_loc)
        subprocess.run(["notify-send", "-a", "Language Settings", "-i", "preferences-desktop-locale", "User language updated", f"{label}\nWill take full effect after restarting your session."], capture_output=True, timeout=2)
    except Exception:
        pass

    # Auto-add matching keyboard layout if available
    lang_code = clean_loc.split("_")[0].split(".")[0].lower()
    locale_layout_map = {
        "es": "es", "en": "us", "fr": "fr", "de": "de", "it": "it",
        "pt": "pt", "ru": "ru", "ja": "jp", "zh": "cn", "cmn": "cn",
        "ko": "kr", "ar": "ara", "tr": "tr", "pl": "pl", "nl": "nl",
        "sv": "se", "no": "no", "nb": "no", "nn": "no", "da": "dk",
        "fi": "fi", "el": "gr", "cs": "cz", "ro": "ro", "hu": "hu",
        "uk": "ua", "he": "il", "bg": "bg", "sk": "sk", "hr": "hr",
        "sl": "si", "et": "ee", "lv": "lv", "lt": "lt", "ca": "es",
        "vi": "vn", "th": "th", "id": "us", "ms": "us", "fil": "us",
        "hi": "in", "bn": "bd", "ur": "pk", "fa": "ir", "sw": "us",
        "is": "is", "ga": "ie", "uz": "uz", "si": "lk", "ta": "lk"
    }
    match_lay = locale_layout_map.get(lang_code)
    if match_lay:
        try:
            kb = get_primary_keyboard()
            layouts_raw = (kb.get("layout", "us") if kb else "us") or "us"
            curr_codes = [c.strip().lower() for c in layouts_raw.split(",") if c.strip()]
            if match_lay not in curr_codes:
                curr_codes.append(match_lay)
                new_str = ",".join(curr_codes)
                hypr_eval(f'hl.config({{ input = {{ kb_layout = "{new_str}" }} }})')
                persist_hyprland_config(new_layouts_str=new_str)
        except Exception:
            pass

    notify_quickshell()
    print(json.dumps({"status": "user_locale_updated", "locale": clean_loc}))

def set_system_locale(loc):
    clean_loc = loc.strip()
    if not clean_loc:
        return
    if not clean_loc.endswith(".UTF-8") and not clean_loc.endswith(".utf8") and clean_loc != "C":
        clean_loc = f"{clean_loc}.UTF-8"

    ensure_locale_generated(clean_loc)

    try:
        subprocess.run(["localectl", "set-locale", f"LANG={clean_loc}"], capture_output=True, timeout=3)
    except Exception:
        pass

    set_user_locale(clean_loc)

    try:
        label = next((l["label"] for l in POPULAR_LOCALES if l["locale"] == clean_loc), clean_loc)
        subprocess.run(["notify-send", "-a", "Language Settings", "-i", "preferences-desktop-locale", "System language updated", f"{label} (localectl)."], capture_output=True, timeout=2)
    except Exception:
        pass

    print(json.dumps({"status": "system_locale_updated", "locale": clean_loc}))

def notify_quickshell():
    qs_path = str(Path.home() / ".config/quickshell/waybar-island/shell.qml")
    for cmd in [
        ["quickshell", "ipc", "-p", qs_path, "--any-display", "call", "island", "reloadLanguage", ""],
        ["quickshell", "ipc", "-p", qs_path, "--any-display", "call", "island", "refreshLanguages", ""],
        ["quickshell", "ipc", "-c", "waybar-island", "call", "island", "reloadLanguage", ""]
    ]:
        try:
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=os.environ, timeout=0.8)
            break
        except Exception:
            pass

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        print(json.dumps(get_status()))
    elif cmd == "switch":
        if len(sys.argv) > 2 and sys.argv[2] != "next":
            switch_layout(sys.argv[2])
        else:
            switch_next()
    elif cmd == "restore":
        restore_layout()
    elif cmd == "add":
        if len(sys.argv) > 2:
            add_layout(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "missing layout code"}))
    elif cmd == "remove":
        if len(sys.argv) > 2:
            remove_layout(sys.argv[2])
        else:
            print(json.dumps({"status": "error", "message": "missing layout id"}))
    elif cmd == "set_hotkey":
        opt = sys.argv[2] if len(sys.argv) > 2 else ""
        set_hotkey(opt)
    elif cmd == "set_user_locale":
        if len(sys.argv) > 2:
            set_user_locale(sys.argv[2])
    elif cmd == "set_system_locale":
        if len(sys.argv) > 2:
            set_system_locale(sys.argv[2])
    elif cmd == "available_layouts":
        if HAVE_HYPRLAND_LANGUAGES:
            try:
                _, lays = get_cached_locales_and_layouts()
                out = []
                for l in lays:
                    out.append({
                        "code": l.code,
                        "label": f"{l.description} ({l.code})",
                        "flag": l.flag
                    })
                print(json.dumps(out))
            except Exception:
                print(json.dumps(POPULAR_LAYOUTS))
        else:
            print(json.dumps(POPULAR_LAYOUTS))
    elif cmd in ("available_locales", "available_languages"):
        out = []
        seen_locales = set()

        # 1. Primary curated locales (51 from locales.json)
        loc_file = Path.home() / ".config/rhythm/i18n/locales.json"
        if loc_file.exists():
            try:
                data = json.loads(loc_file.read_text(encoding="utf-8"))
                for code, item in data.items():
                    loc = item.get("locale", "")
                    seen_locales.add(loc.lower())
                    seen_locales.add(loc.replace(".UTF-8", "").lower())
                    name_val = item.get("name", code)
                    out.append({
                        "code": code,
                        "locale": loc,
                        "name": name_val,
                        "englishName": item.get("englishName", ""),
                        "label": f"{name_val} ({loc})",
                        "flag": item.get("flag", "🌐")
                    })
            except Exception:
                pass

        # 2. All extra locales from locale.gen / hyprland_languages
        if HAVE_HYPRLAND_LANGUAGES:
            try:
                from hyprland_languages.locales import load_all_locales
                for l in load_all_locales():
                    clean = l.code.lower()
                    clean_base = clean.split(".")[0]
                    if clean in seen_locales or clean_base in seen_locales:
                        continue
                    if "utf" in clean:
                        seen_locales.add(clean)
                        out.append({
                            "code": l.lang,
                            "locale": l.code,
                            "name": l.lang_name or l.display_name_es,
                            "englishName": l.lang_en,
                            "label": l.display_name_es or f"{l.lang_name} ({l.code})",
                            "flag": l.flag or "🌐"
                        })
            except Exception:
                pass

        if not out:
            out = POPULAR_LOCALES
        print(json.dumps(out))
        return
    elif cmd == "generate_all":
        if HAVE_HYPRLAND_LANGUAGES:
            try:
                from hyprland_languages.locales import generate_all_locales
                ok, msg = generate_all_locales()
                print(json.dumps({"status": "ok" if ok else "error", "message": msg}))
            except Exception as e:
                print(json.dumps({"status": "error", "message": str(e)}))
        else:
            print(json.dumps({"status": "error", "message": "hyprland_languages not available"}))
    else:
        print(json.dumps({"status": "unknown_command"}))

if __name__ == "__main__":
    main()
