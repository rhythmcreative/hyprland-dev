#!/bin/bash
# Envoltorio de rofi: le añade el fondo translúcido común y, con el ahorro de
# energía activo, el macizo por encima.
#
# Existe porque cada menú se ponyía el fondo por su cuenta y se le olvidaba a la
# mitad. Estos dos atajos se llegaron a arreglar tres veces distintas y en las
# tres había un menú más sin tocar:
#
#     SUPER + A            -> rofi-style3-monitor-adaptive
#     SUPER + SHIFT + W    -> wallpaper-selector        <- no wallpaper-changer
#     SUPER + ALT + W      -> wallpaper-changer-with-waybar-sync
#
# Con el envoltorio los menus no tienen que acordarse de nada: se lanzan igual
# que siempre y el fondo sale bien.
#
# Se anade al final para que gane sobre lo que traiga el tema del menu.
#
# -theme-str y no un segundo -theme: rofi ignora un segundo fichero de tema y se
# queda con el primero. Y van como array porque el css tiene espacios; metido en
# una cadena sin entrecomillar se parte en montones de argumentos sueltos.

# El fondo del ahorro se deja al dia antes de leerlo. Antes lo escribia solo
# toggle-powersave, asi que al cambiar el fondo con el ahorro activo el macizo
# se quedaba con el color del fondo anterior; medido: fondo #884400 y el
# fichero seguia en #151921. rofi-colors lo regenera siempre y solo escribe si
# el contenido cambia.
"$HOME/.local/bin/rofi-colors" 2>/dev/null || true

# Sincronizar dinamicamente con el idioma activo del sistema (Rhythm / Omarchy)
if [ -f "$HOME/.config/environment.d/10-locale.conf" ]; then
    . "$HOME/.config/environment.d/10-locale.conf"
    export LANG LC_MESSAGES LANGUAGE
fi

active_lang="es"
if [ -f "$HOME/.config/rhythm/language" ]; then
    active_lang=$(head -n 1 "$HOME/.config/rhythm/language" 2>/dev/null | tr -d '[:space:]')
fi

# Placeholder localizado dinámicamente según idioma activo (51 idiomas soportados)
placeholder_text=$(rhythm-i18n "rofi_search_apps" "Buscar aplicaciones..." "$active_lang" 2>/dev/null || echo "Buscar aplicaciones...")

# Asegurar locale UTF-8 valido para evitar que rofi falle con 'Failed to set locale'
if ! locale >/dev/null 2>&1; then
    export LC_ALL="${LANG:-C.UTF-8}"
fi

# Limpiar pidfile huerfano o conmutar rofi si ya esta abierto
pid_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/rofi.pid"
if [ -f "$pid_file" ]; then
    old_pid=$(cat "$pid_file" 2>/dev/null)
    if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
        kill "$old_pid" 2>/dev/null || true
        rm -f "$pid_file" 2>/dev/null || true
        exit 0
    else
        rm -f "$pid_file" 2>/dev/null || true
    fi
fi

args=("$@")

# En modo normal no se toca el fondo: cada menu se queda con el suyo, que es como
# estaba siempre, con su translucidez y el desenfoque del compositor detras. Antes
# se imponia un fondo comun al 80% y con eso solo se veia el 20% del escritorio,
# asi que el blur casi no se apreciaba y el menu perdia el aspecto que tenia.
#
# En los modos que apagan los efectos el fondo macizo es lo que toca, porque si no
# el translucido se queda plano: sin desenfoque detras solo se ve el color del
# escritorio, sin suavizar, y el menu se lee peor de lo que se leia antes.
macizo="$HOME/.config/rofi/colors-solid.rasi"

sin_efectos() {
    # Las banderas de /tmp son solo una pista. La verdad es lo que diga el
    # compositor, y se desincronizan solas: power_save.sh y optimize_performance.sh
    # aplican el estado con "hyprctl --batch", y cualquier "hyprctl reload"
    # posterior restaura los valores de la config SIN tocar /tmp. El OTA hace un
    # reload en cada actualizacion, asi que una bandera se queda puesta con el
    # sistema ya en modo normal.
    #
    # Medido: /tmp/hyprland_power_save puesto, blur activo y active_opacity 0.85,
    # que es modo normal, y los menus salian macizos. Con solo mirar la bandera
    # no hay manera de distinguir ese caso de un ahorro real.
    #
    # Asi que: si hay bandera pero el desenfoque esta activo, el compositor no
    # esta en modo sin efectos y no se aplica el macizo.
    [ -f /tmp/powersave-active ] || [ -f /tmp/hypr_performance_mode ] || [ -f /tmp/hyprland_power_save ] || return 1

    local blur
    blur=$(hyprctl getoption decoration:blur:enabled 2>/dev/null | head -1)
    case "$blur" in
        *true*) return 1 ;;   # desenfoque activo: modo normal, fondo translucido
        *)      return 0 ;;   # sin desenfoque: modo sin efectos, fondo macizo
    esac
}

if sin_efectos && [ -f "$macizo" ]; then
    args+=(-theme-str "$(cat "$macizo")")
fi

# Aplicar placeholder localizado a lanzadores de aplicaciones
is_app_launcher=false
for a in "$@"; do
    if [ "$a" = "drun" ] || [ "$a" = "-show" ] || [ "$a" = "run" ]; then
        is_app_launcher=true
        break
    fi
done

if $is_app_launcher && [ -n "$placeholder_text" ]; then
    args+=(-theme-str "entry { placeholder: \"$placeholder_text\"; }")
fi

exec rofi "${args[@]}"
