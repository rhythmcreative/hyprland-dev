#!/usr/bin/env python3
import glob
import json
import os
import re
import shutil
import subprocess
import time

STATE_FILE = "/dev/shm/notch_sysmon_state.json"
GPU_NAMES_FILE = "/dev/shm/notch_sysmon_gpu_names.json"
HIST_LEN = 36

CLK_TCK = os.sysconf(os.sysconf_names["SC_CLK_TCK"]) if "SC_CLK_TCK" in os.sysconf_names else 100
PAGE_SIZE = os.sysconf(os.sysconf_names["SC_PAGE_SIZE"]) if "SC_PAGE_SIZE" in os.sysconf_names else 4096


def safe_int(val, default=0):
    try:
        return int(round(float(str(val).strip())))
    except Exception:
        return default


def safe_float(val, default=0.0):
    try:
        return float(str(val).strip())
    except Exception:
        return default


def load_json(path):
    try:
        with open(path, "r") as f:
            return json.load(f)
    except Exception:
        return {}


def save_json(path, data):
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, separators=(",", ":"))
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except Exception:
            pass


def clean_cpu_model(raw):
    if not raw:
        return "Processor"
    s = raw
    s = re.sub(r"\(R\)|\(TM\)|\(tm\)", "", s)
    s = re.sub(r"\bwith Radeon.*$", "", s, flags=re.IGNORECASE)
    s = re.sub(r"\bCPU\s*@.*$", "", s, flags=re.IGNORECASE)
    s = re.sub(r"^\d+(?:st|nd|rd|th)\s+Gen\s+", "", s, flags=re.IGNORECASE)
    s = re.sub(r"^(AMD|Intel)\s+", "", s, flags=re.IGNORECASE)
    s = re.sub(r"\b\d+-Core Processor$", "", s, flags=re.IGNORECASE)
    s = re.sub(r"\s+", " ", s).strip()
    return s or raw.strip()


def clean_gpu_name(raw, vendor=""):
    if not raw:
        return "GPU"
    s = raw.strip()
    if vendor == "nvidia":
        s = re.sub(r"^NVIDIA\s+GeForce\s+", "", s, flags=re.IGNORECASE)
        s = re.sub(r"^NVIDIA\s+", "", s, flags=re.IGNORECASE)
        s = s.replace("Laptop GPU", "Mobile")
        s = re.sub(r"\s*\(rev [^)]+\)\s*$", "", s)
        return s.strip()
    # Extract descriptive marketing name inside brackets if present (e.g. "Rembrandt [Radeon 680M]")
    brackets = re.findall(r"\[([^\]]+)\]", s)
    filtered = [b.strip() for b in brackets if b.strip().upper() not in ("AMD/ATI", "AMD", "ATI", "NVIDIA", "INTEL")]
    if filtered:
        s = filtered[-1]
    else:
        for prefix in ("Advanced Micro Devices, Inc. ", "Intel Corporation ", "NVIDIA Corporation "):
            if s.startswith(prefix):
                s = s[len(prefix):]
    s = re.sub(r"\s*\(rev [^)]+\)\s*$", "", s)
    s = re.sub(r"^GeForce\s+", "", s, flags=re.IGNORECASE)
    s = re.sub(r"^AMD\s+", "", s, flags=re.IGNORECASE)
    s = s.replace("Laptop GPU", "Mobile")
    s = re.sub(r"\s+", " ", s).strip()
    return s or "GPU"


def format_mb_compact(mb):
    if mb >= 1024:
        return f"{mb / 1024.0:.1f}G"
    return f"{int(round(mb))}M"


def read_proc_stat():
    stats = {}
    try:
        with open("/proc/stat", "r") as f:
            for line in f:
                if not line.startswith("cpu"):
                    break
                parts = line.split()
                name = parts[0]
                vals = [int(x) for x in parts[1:8]]
                idle = vals[3] + (vals[4] if len(vals) > 4 else 0)
                total = sum(vals)
                stats[name] = [idle, total]
    except Exception:
        pass
    return stats


def read_proc_table(exclude_pids):
    """Pure /proc scanner: returns dict keyed by 'pid:starttime' -> info + counts."""
    procs = {}
    total_tasks = 0
    running_tasks = 0
    try:
        entries = os.listdir("/proc")
    except Exception:
        return procs, 0, 0

    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid in exclude_pids:
            continue
        try:
            with open(f"/proc/{entry}/stat", "rb") as f:
                raw = f.read()
            lp = raw.find(b"(")
            rp = raw.rfind(b")")
            if lp < 0 or rp <= lp:
                continue
            comm = raw[lp + 1 : rp].decode("utf-8", errors="replace").strip()
            fields = raw[rp + 2 :].split()
            if len(fields) < 22:
                continue
            state = fields[0].decode("ascii", errors="ignore")
            ppid = int(fields[1])
            # Skip kernel threads (kthreadd and children)
            if pid == 2 or ppid == 2:
                continue
            total_tasks += 1
            if state == "R":
                running_tasks += 1
            utime = int(fields[11])
            stime = int(fields[12])
            starttime = int(fields[19])
            rss_pages = int(fields[21])
            key = f"{pid}:{starttime}"
            procs[key] = {
                "pid": pid,
                "comm": comm,
                "ticks": utime + stime,
                "rss_mb": (rss_pages * PAGE_SIZE) / (1024.0 * 1024.0),
            }
        except Exception:
            continue

    return procs, total_tasks, running_tasks


def friendly_proc_name(pid, comm):
    # Improve generic interpreter names (python3, node, bash, sh) without extra work for normal binaries
    if comm in ("python", "python3", "node", "bash", "sh", "ruby", "perl"):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                args = [a.decode("utf-8", errors="replace") for a in f.read().split(b"\x00") if a]
            for arg in args[1:]:
                if not arg or arg.startswith("-"):
                    continue
                base = os.path.basename(arg)
                if base and base not in ("-c", "env"):
                    return base[:24]
        except Exception:
            pass
    return comm[:24]


def get_cpu_temp_and_freq():
    freq_ghz = 0.0
    try:
        freqs = []
        for p in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"):
            try:
                with open(p, "r") as f:
                    freqs.append(int(f.read().strip()))
            except Exception:
                pass
        if freqs:
            freq_ghz = round((sum(freqs) / len(freqs)) / 1_000_000.0, 2)
    except Exception:
        pass

    temp_c = 0
    preferred = ("k10temp", "coretemp", "zenpower", "cpu_thermal")
    for hw in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
        try:
            with open(os.path.join(hw, "name"), "r") as f:
                hwn = f.read().strip().lower()
            if hwn in preferred or "k10temp" in hwn:
                for cand in ("temp1_input", "temp2_input"):
                    tp = os.path.join(hw, cand)
                    if os.path.exists(tp):
                        with open(tp, "r") as tf:
                            val = int(int(tf.read().strip()) / 1000)
                            if 10 <= val <= 125:
                                temp_c = val
                                break
                if temp_c > 0:
                    break
        except Exception:
            pass

    if temp_c == 0:
        for tp in sorted(glob.glob("/sys/class/thermal/thermal_zone*/temp")):
            try:
                with open(tp, "r") as f:
                    val = int(int(f.read().strip()) / 1000)
                    if 20 <= val <= 115:
                        temp_c = val
                        break
            except Exception:
                pass

    return temp_c, freq_ghz


def get_cpu_model():
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if line.startswith("model name"):
                    return line.split(":", 1)[1].strip()
    except Exception:
        pass
    return "Processor"


def get_mem_info():
    mem = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                p = line.split(":", 1)
                if len(p) == 2:
                    mem[p[0].strip()] = int(p[1].strip().split()[0])
    except Exception:
        pass

    total_ram = mem.get("MemTotal", 0) / 1048576.0
    avail_ram = mem.get("MemAvailable", 0) / 1048576.0
    used_ram = max(0.0, total_ram - avail_ram)
    ram_pct = int(round((used_ram / total_ram) * 100)) if total_ram > 0 else 0

    total_swap = mem.get("SwapTotal", 0) / 1048576.0
    free_swap = mem.get("SwapFree", 0) / 1048576.0
    used_swap = max(0.0, total_swap - free_swap)
    swap_pct = int(round((used_swap / total_swap) * 100)) if total_swap > 0 else 0

    return {
        "ram": {
            "total_gb": round(total_ram, 1),
            "used_gb": round(used_ram, 1),
            "free_gb": round(avail_ram, 1),
            "pct": ram_pct,
            "str": f"{used_ram:.1f} / {total_ram:.1f}G",
        },
        "swap": {
            "total_gb": round(total_swap, 1),
            "used_gb": round(used_swap, 1),
            "pct": swap_pct,
            "str": f"{used_swap:.1f} / {total_swap:.1f}G" if total_swap > 0 else "off",
        },
        "total_ram_mb": max(1.0, total_ram * 1024.0),
    }


def get_disk_info():
    try:
        total, used, free = shutil.disk_usage("/")
        total_gb = int(round(total / (1024**3)))
        used_gb = int(round(used / (1024**3)))
        free_gb = int(round(free / (1024**3)))
        pct = int(round((used / total) * 100)) if total else 0
    except Exception:
        total_gb, used_gb, free_gb, pct = 0, 0, 0, 0

    return {
        "total_gb": total_gb,
        "used_gb": used_gb,
        "free_gb": free_gb,
        "pct": pct,
        "str": f"{used_gb} / {total_gb}G",
    }


def get_cached_pci_gpu_names():
    cached = load_json(GPU_NAMES_FILE)
    if cached and isinstance(cached, dict) and cached.get("slots"):
        return cached
    slots = {}
    try:
        res = subprocess.run(["lspci"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=1)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                low = line.lower()
                if any(w in low for w in ("vga", "3d", "display")):
                    pci_id = line.split()[0].strip()
                    desc = line.split(":", 2)[-1].strip()
                    slots[pci_id] = desc
                    if not pci_id.startswith("0000:"):
                        slots[f"0000:{pci_id}"] = desc
    except Exception:
        pass
    data = {"slots": slots, "nv_names": cached.get("nv_names", {}) if isinstance(cached, dict) else {}}
    save_json(GPU_NAMES_FILE, data)
    return data


def get_gpu_info(prev_state, new_gpu_hist):
    devices = []
    pci_cache = get_cached_pci_gpu_names()
    pci_slots = pci_cache.get("slots", {})
    nv_names_cache = pci_cache.get("nv_names", {})
    nv_cache_dirty = False
    prev_gpu_hist = prev_state.get("gpu_busy_hist", {}) if isinstance(prev_state, dict) else {}

    # 1. Integrated / Open-driver DRM GPUs first (AMD / Intel) -> stable visual order
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        device = os.path.join(card, "device")
        if not os.path.exists(device):
            continue
        driver_path = os.path.join(device, "driver")
        driver_name = os.path.basename(os.path.realpath(driver_path)) if os.path.exists(driver_path) else ""
        if driver_name == "nvidia":
            continue

        pci_slot = ""
        uevent_path = os.path.join(device, "uevent")
        if os.path.exists(uevent_path):
            try:
                with open(uevent_path, "r") as f:
                    for uline in f:
                        if uline.startswith("PCI_SLOT_NAME="):
                            pci_slot = uline.split("=", 1)[1].strip()
                            break
            except Exception:
                pass

        short_slot = pci_slot[5:] if pci_slot.startswith("0000:") else pci_slot
        gpu_name = pci_slots.get(pci_slot) or pci_slots.get(short_slot) or ""

        if "amd" in driver_name or "radeon" in driver_name:
            vendor = "amd"
            if not gpu_name:
                gpu_name = "AMD Radeon Graphics"
        elif "i915" in driver_name or "xe" in driver_name:
            vendor = "intel"
            if not gpu_name:
                gpu_name = "Intel Graphics"
        elif driver_name:
            vendor = driver_name
            if not gpu_name:
                gpu_name = f"{driver_name.upper()} GPU"
        else:
            continue

        # Check runtime_status if available
        rt_status = "active"
        rt_path = os.path.join(device, "power/runtime_status")
        if os.path.exists(rt_path):
            try:
                with open(rt_path, "r") as f:
                    rt_status = f.read().strip()
            except Exception:
                pass
        suspended = rt_status == "suspended"

        temp_c = 0
        util_pct = -1
        vram_used_mb = 0
        vram_total_mb = 0
        vram_str = ""

        if not suspended:
            for hw in sorted(glob.glob(os.path.join(device, "hwmon/hwmon*"))):
                for cand in ("temp1_input", "temp2_input"):
                    tp = os.path.join(hw, cand)
                    if os.path.exists(tp):
                        try:
                            with open(tp, "r") as tf:
                                t_val = int(int(tf.read().strip()) / 1000)
                                if 15 <= t_val <= 125:
                                    temp_c = t_val
                                    break
                        except Exception:
                            pass
                if temp_c > 0:
                    break

            busy_file = os.path.join(device, "gpu_busy_percent")
            if os.path.exists(busy_file):
                try:
                    with open(busy_file, "r") as f:
                        raw_busy = max(0, min(100, int(f.read().strip())))
                    # 3-sample moving average avoids single-frame animation spike on panel open
                    hist = list(prev_gpu_hist.get(card, []))
                    hist.append(raw_busy)
                    hist = hist[-3:]
                    new_gpu_hist[card] = hist
                    util_pct = int(round(sum(hist) / len(hist)))
                except Exception:
                    pass

            vu = os.path.join(device, "mem_info_vram_used")
            vt = os.path.join(device, "mem_info_vram_total")
            if os.path.exists(vu) and os.path.exists(vt):
                try:
                    with open(vu, "r") as fu, open(vt, "r") as ft:
                        vram_used_mb = int(int(fu.read().strip()) / (1024**2))
                        vram_total_mb = int(int(ft.read().strip()) / (1024**2))
                        if vram_total_mb > 0:
                            vram_str = f"{format_mb_compact(vram_used_mb)} / {format_mb_compact(vram_total_mb)}"
                except Exception:
                    pass

        short_name = clean_gpu_name(gpu_name, vendor)
        devices.append({
            "name": gpu_name or short_name,
            "short_name": short_name,
            "vendor": vendor,
            "type": "integrated" if any(w in (gpu_name + " " + short_name).lower() for w in ("integrated", "680m", "780m", "660m", "vega", "uhd", "iris", "rembrandt", "phoenix")) else "discrete",
            "suspended": suspended,
            "temp_c": temp_c,
            "util_pct": max(0, util_pct) if util_pct >= 0 else 0,
            "has_util": (util_pct >= 0 and not suspended),
            "vram_used_mb": vram_used_mb,
            "vram_total_mb": vram_total_mb,
            "vram_pct": int(round((vram_used_mb / vram_total_mb) * 100)) if vram_total_mb > 0 else 0,
            "vram_str": vram_str,
            "power_w": 0,
        })

    # 2. NVIDIA discrete GPUs — NEVER wake D3cold/suspended dGPU!
    nv_pci_devs = []
    for dev in sorted(glob.glob("/sys/bus/pci/devices/*")):
        try:
            with open(os.path.join(dev, "vendor"), "r") as fv:
                if fv.read().strip().lower() != "0x10de":
                    continue
            with open(os.path.join(dev, "class"), "r") as fc:
                cls = fc.read().strip().lower()
            if not cls.startswith("0x03"):
                continue
            slot = os.path.basename(dev)
            rt = "active"
            rtp = os.path.join(dev, "power/runtime_status")
            if os.path.exists(rtp):
                with open(rtp, "r") as fr:
                    rt = fr.read().strip()
            nv_pci_devs.append((slot, rt))
        except Exception:
            continue

    active_nv = [s for s, rt in nv_pci_devs if rt == "active"]
    suspended_nv = [s for s, rt in nv_pci_devs if rt != "active"]

    if active_nv and shutil.which("nvidia-smi"):
        try:
            res = subprocess.run(
                [
                    "nvidia-smi",
                    "--query-gpu=pci.bus_id,gpu_name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw",
                    "--format=csv,noheader,nounits",
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                timeout=1,
            )
            if res.returncode == 0 and res.stdout.strip() and "mismatch" not in res.stdout.lower():
                for line in res.stdout.strip().splitlines():
                    parts = [x.strip() for x in line.split(",")]
                    if len(parts) >= 6:
                        bus_id = parts[0].lower().replace("00000000:", "0000:")
                        name = parts[1]
                        short_name = clean_gpu_name(name, "nvidia")
                        temp_c = safe_int(parts[2], 0)
                        util_pct = max(0, min(100, safe_int(parts[3], 0)))
                        vram_used = safe_int(parts[4], 0)
                        vram_total = safe_int(parts[5], 0)
                        power_w = safe_int(parts[6], 0) if len(parts) >= 7 else 0
                        if bus_id and nv_names_cache.get(bus_id) != short_name:
                            nv_names_cache[bus_id] = short_name
                            nv_cache_dirty = True
                        devices.append({
                            "name": name,
                            "short_name": short_name,
                            "vendor": "nvidia",
                            "type": "discrete",
                            "suspended": False,
                            "temp_c": temp_c,
                            "util_pct": util_pct,
                            "has_util": True,
                            "vram_used_mb": vram_used,
                            "vram_total_mb": vram_total,
                            "vram_pct": int(round((vram_used / vram_total) * 100)) if vram_total > 0 else 0,
                            "vram_str": f"{format_mb_compact(vram_used)} / {format_mb_compact(vram_total)}" if vram_total > 0 else "",
                            "power_w": power_w,
                        })
        except Exception:
            pass

    for slot in suspended_nv:
        short_slot = slot[5:] if slot.startswith("0000:") else slot
        raw_name = nv_names_cache.get(slot.lower()) or pci_slots.get(slot) or pci_slots.get(short_slot) or "NVIDIA GPU"
        short_name = clean_gpu_name(raw_name, "nvidia")
        devices.append({
            "name": raw_name,
            "short_name": short_name,
            "vendor": "nvidia",
            "type": "discrete",
            "suspended": True,
            "temp_c": 0,
            "util_pct": 0,
            "has_util": False,
            "vram_used_mb": 0,
            "vram_total_mb": 0,
            "vram_pct": 0,
            "vram_str": "",
            "power_w": 0,
        })

    if nv_cache_dirty:
        pci_cache["nv_names"] = nv_names_cache
        save_json(GPU_NAMES_FILE, pci_cache)

    nv_device = next((d for d in devices if d["vendor"] == "nvidia"), {})
    amd_temp = next((d["temp_c"] for d in devices if d["vendor"] == "amd"), 0)

    return {
        "devices": devices,
        "count": len(devices),
        "has_nvidia": bool(nv_device),
        "nvidia_name": nv_device.get("short_name", "NVIDIA GPU"),
        "nvidia_temp": nv_device.get("temp_c", 0),
        "nvidia_util": nv_device.get("util_pct", 0),
        "nvidia_vram_used": nv_device.get("vram_used_mb", 0),
        "nvidia_vram_total": nv_device.get("vram_total_mb", 0),
        "amd_temp": amd_temp,
    }


def get_system_summary(tasks_total, tasks_running):
    uptime_str = "0m"
    try:
        with open("/proc/uptime", "r") as f:
            up_secs = int(float(f.read().split()[0]))
        days = up_secs // 86400
        hours = (up_secs % 86400) // 3600
        mins = (up_secs % 3600) // 60
        if days > 0:
            uptime_str = f"{days}d {hours}h"
        elif hours > 0:
            uptime_str = f"{hours}h {mins}m"
        else:
            uptime_str = f"{mins}m"
    except Exception:
        pass

    kernel = "Linux"
    kernel_short = "Linux"
    try:
        kernel = os.uname().release
        m = re.match(r"^(\d+\.\d+\.\d+)", kernel)
        kernel_short = m.group(1) if m else kernel
    except Exception:
        pass

    load_str = "0.00  0.00  0.00"
    try:
        l1, l5, l15 = os.getloadavg()
        load_str = f"{l1:.2f}  {l5:.2f}  {l15:.2f}"
    except Exception:
        pass

    return {
        "uptime": uptime_str,
        "kernel": kernel,
        "kernel_short": kernel_short,
        "load_avg": load_str,
        "tasks_total": tasks_total,
        "tasks_running": tasks_running,
    }


def main():
    my_pid = os.getpid()
    parent_pid = os.getppid()
    exclude_pids = {my_pid}
    # If invoked through a tiny bash -c wrapper from Quickshell, exclude that transient wrapper too
    try:
        with open(f"/proc/{parent_pid}/comm", "r") as f:
            if f.read().strip() in ("bash", "sh", "dash"):
                exclude_pids.add(parent_pid)
    except Exception:
        pass

    prev = load_json(STATE_FILE)
    now = time.monotonic()
    prev_ts = safe_float(prev.get("ts"), 0.0)
    dt = now - prev_ts if prev_ts > 0 else 999.0

    # On cold start or stale state (>12s), take an instant 120ms delta so even frame 1 is real & accurate
    if dt < 0.12 or dt > 12.0 or not prev.get("cpu"):
        cpu_a = read_proc_stat()
        procs_a, _, _ = read_proc_table(exclude_pids)
        t_a = time.monotonic()
        time.sleep(0.12)
        cpu_b = read_proc_stat()
        procs_b, tasks_total, tasks_running = read_proc_table(exclude_pids)
        t_b = time.monotonic()
        prev_cpu = cpu_a
        prev_procs = {k: v["ticks"] for k, v in procs_a.items()}
        curr_cpu = cpu_b
        curr_procs = procs_b
        dt = max(0.05, t_b - t_a)
        now = t_b
    else:
        prev_cpu = prev.get("cpu", {})
        prev_procs = prev.get("procs", {})
        curr_cpu = read_proc_stat()
        curr_procs, tasks_total, tasks_running = read_proc_table(exclude_pids)

    cores_count = os.cpu_count() or 1
    pcts = {}
    for k, v in curr_cpu.items():
        if k in prev_cpu:
            d_total = v[1] - prev_cpu[k][1]
            d_idle = v[0] - prev_cpu[k][0]
            if d_total > 0:
                pcts[k] = max(0, min(100, int(round((1.0 - (d_idle / d_total)) * 100))))
            else:
                pcts[k] = 0
        else:
            pcts[k] = 0

    total_pct = pcts.get("cpu", 0)
    cores = [{"id": i, "pct": pcts.get(f"cpu{i}", total_pct)} for i in range(cores_count)]

    mem_data = get_mem_info()
    total_ram_mb = mem_data["total_ram_mb"]

    # Real-time per-process CPU% delta + exact RSS MB
    dt_ticks = max(1.0, dt * CLK_TCK)
    max_proc_cpu = cores_count * 100.0
    proc_list = []
    for key, info in curr_procs.items():
        comm = info["comm"]
        if comm == "notch-system-monitor":
            continue
        p_ticks = prev_procs.get(key)
        if p_ticks is not None and info["ticks"] >= p_ticks:
            cpu_pct = ((info["ticks"] - p_ticks) / dt_ticks) * 100.0
            cpu_pct = min(max_proc_cpu, max(0.0, cpu_pct))
        else:
            cpu_pct = 0.0

        rss_mb = info["rss_mb"]
        mem_pct = (rss_mb / total_ram_mb) * 100.0
        proc_list.append({
            "pid": str(info["pid"]),
            "comm": comm,
            "cpu": round(cpu_pct, 1),
            "mem": round(mem_pct, 1),
            "rss_mb": rss_mb,
            "mem_str": format_mb_compact(rss_mb),
        })

    top_cpu = sorted(proc_list, key=lambda x: (x["cpu"], x["rss_mb"]), reverse=True)[:8]
    top_mem = sorted(proc_list, key=lambda x: (x["rss_mb"], x["cpu"]), reverse=True)[:8]

    # Resolve friendly names only for the small displayed subset (<=16 procs)
    for bucket in (top_cpu, top_mem):
        for p in bucket:
            if "name" not in p:
                p["name"] = friendly_proc_name(int(p["pid"]), p["comm"])
                p.pop("comm", None)
                p.pop("rss_mb", None)

    # Maintain rolling 36-sample history
    cpu_hist = list(prev.get("cpu_hist", [])) if dt <= 30.0 else []
    ram_hist = list(prev.get("ram_hist", [])) if dt <= 30.0 else []
    cpu_hist.append(total_pct)
    ram_hist.append(mem_data["ram"]["pct"])
    cpu_hist = cpu_hist[-HIST_LEN:]
    ram_hist = ram_hist[-HIST_LEN:]

    new_gpu_hist = {}
    gpu_data = get_gpu_info(prev, new_gpu_hist)

    # Save compact state atomically in /dev/shm
    save_json(
        STATE_FILE,
        {
            "ts": now,
            "cpu": curr_cpu,
            "procs": {k: v["ticks"] for k, v in curr_procs.items()},
            "cpu_hist": cpu_hist,
            "ram_hist": ram_hist,
            "gpu_busy_hist": new_gpu_hist,
        },
    )

    temp_c, freq_ghz = get_cpu_temp_and_freq()
    raw_model = get_cpu_model()
    sys_data = get_system_summary(tasks_total, tasks_running)

    result = {
        "cpu": {
            "model": raw_model,
            "short_model": clean_cpu_model(raw_model),
            "cores_count": cores_count,
            "total_pct": total_pct,
            "freq_ghz": freq_ghz,
            "temp_c": temp_c,
            "cores": cores,
            "history": cpu_hist,
            "load_avg": sys_data["load_avg"],
        },
        "ram": {**mem_data["ram"], "history": ram_hist},
        "swap": mem_data["swap"],
        "disk": get_disk_info(),
        "gpu": gpu_data,
        "system": sys_data,
        "procs_cpu": top_cpu,
        "procs_mem": top_mem,
    }
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
