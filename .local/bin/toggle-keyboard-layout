#!/bin/bash
# Cambia al siguiente layout de teclado sincronizando todos los teclados reales (Wooting, laptop, etc.)
set -u

res=$("$HOME/.local/bin/notch-language-helper" switch 2>/dev/null || echo "")

code=$(python3 -c "
import json, sys
try:
    data = json.loads('''$res''')
    print(data.get('code', '').upper())
except Exception:
    sys.exit(0)
" 2>/dev/null)

if [ -z "$code" ]; then
    code=$("$HOME/.local/bin/kb-layout" 2>/dev/null || echo "")
fi

if [ "${1:-}" = "--notify" ] && command -v notify-send >/dev/null 2>&1 && [ -n "$code" ]; then
    n_title=$(rhythm-i18n "notif_kb_title" "Keyboard Layout" 2>/dev/null || echo "Keyboard Layout")
    n_body=$(rhythm-i18n "notif_kb_switched" "Active layout: {layout}" 2>/dev/null || echo "Active layout: {layout}")
    n_body="${n_body//\{layout\}/$code}"
    notify-send "$n_title" "$n_body" -t 1200 -i input-keyboard >/dev/null 2>&1 || true
fi

echo "${code:-desconocido}"
