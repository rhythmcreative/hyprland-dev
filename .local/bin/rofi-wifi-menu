#!/bin/bash
export PATH="$HOME/.local/bin:$PATH"

# Menu interactivo de Wi-Fi para Rofi y Hyprland
# Tema y colores sincronizados con Pywal

THEME_FILE="$HOME/.config/rofi/settings.rasi"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    if [ -n "$WL_DISP" ]; then
        export WAYLAND_DISPLAY=$(basename "$WL_DISP")
    else
        export WAYLAND_DISPLAY="wayland-1"
    fi
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    if [ -n "$HYPR_SIG" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
    fi
fi

# Prefer opening on the focused monitor's Dynamic Island
ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"
if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call settings open_wifi "$ACTIVE_MON" >/dev/null 2>&1
    exit 0
fi

get_active_monitor() {
    local mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
    [ -n "$mon" ] && [ "$mon" != "null" ] && echo "$mon" && return
    echo "eDP-1"
}
ACTIVE_MON=$(get_active_monitor)

# Hide Waybar, Rust-Dock and Quickshell while Rofi is open (ONLY on active monitor)
if [ -z "$_BARS_HIDDEN" ] && [ -n "$ACTIVE_MON" ]; then
    export _BARS_HIDDEN=1
    if "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
    elif pgrep -x waybar >/dev/null 2>&1 || pgrep -x .waybar-wrapped >/dev/null 2>&1; then
        export _WAYBAR_WAS_VISIBLE=true
        pkill -SIGUSR1 -x waybar 2>/dev/null || pkill -SIGUSR1 -x .waybar-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR1 >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
    elif pgrep -x rust-dock >/dev/null 2>&1 || pgrep -x .rust-dock-wrap >/dev/null 2>&1 || pgrep -x .rust-dock-wrapped >/dev/null 2>&1; then
        export _RUST_DOCK_WAS_VISIBLE=true
        pkill -SIGUSR1 -x rust-dock 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR1 -x .rust-dock-wrapped 2>/dev/null &
    fi
    if "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
        export _QUICKSHELL_WAS_VISIBLE=true
        quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island hide "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
fi

restore_bars() {
    if [ -n "$ACTIVE_MON" ]; then
        [ "$_WAYBAR_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" waybar signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x waybar 2>/dev/null || pkill -SIGUSR2 -x .waybar-wrapped 2>/dev/null & }
        [ "$_RUST_DOCK_WAS_VISIBLE" = "true" ] && { "$HOME/.local/bin/dock-procs" rust-dock signal "$ACTIVE_MON" USR2 >/dev/null 2>&1 || pkill -SIGUSR2 -x rust-dock 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrap 2>/dev/null || pkill -SIGUSR2 -x .rust-dock-wrapped 2>/dev/null & }
        [ "$_QUICKSHELL_WAS_VISIBLE" = "true" ] && quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island reveal "$ACTIVE_MON" >/dev/null 2>&1 &
    fi
}
trap restore_bars EXIT

L_WIFI=$(rhythm-i18n mod_wifi "Wi-Fi")
L_CONNECTED=$(rhythm-i18n mod_wifi_connected "Connected")
L_DISCONNECTED=$(rhythm-i18n mod_wifi_disconnected "Disconnected")
L_CONNECT=$(rhythm-i18n wifi_connect "Connect")
L_DISCONNECT=$(rhythm-i18n wifi_disconnect "Disconnect")
L_BACK=$(rhythm-i18n wifi_back "Back")
L_TITLE=$(rhythm-i18n wifi_title "Wi-Fi Networks")
L_PASS=$(rhythm-i18n wifi_pass_placeholder "Password")

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -t 3000 -i network-wireless "$L_WIFI" "$1"
    fi
}

# Obtener estado de Wi-Fi
WIFI_STATE=$(nmcli -fields WIFI g 2>/dev/null | tail -n 1 | tr -d ' ')

if [[ "$WIFI_STATE" =~ enabled ]] || [ "$WIFI_STATE" = "enabled" ]; then
    TOGGLE_TEXT="󰖪  $L_DISCONNECT Wi-Fi [action:off]"
else
    TOGGLE_TEXT="󰖩  $L_CONNECT Wi-Fi [action:on]"
fi

# Si el Wi-Fi esta desactivado, mostrar opcion para activarlo
if [ "$WIFI_STATE" != "enabled" ]; then
    CHOSEN=$(echo -e "$TOGGLE_TEXT\n󰒓  nm-connection-editor [action:manager]" | rofi-themed -dmenu -i -p "$L_WIFI" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$CHOSEN" in
        *"[action:on]"*|*"Activar Wi-Fi"*|*"Enable"*)
            nmcli radio wifi on
            notify "$L_WIFI: On"
            sleep 2
            exec "$0"
            ;;
        *"[action:manager]"*|*"Administrador"*|*"nm-connection-editor"*)
            nm-connection-editor &
            ;;
    esac
    exit 0
fi

# Escanear y listar redes disponibles (instantaneo usando cache de NetworkManager)
RAW_NETWORKS=$(nmcli -t -f "IN-USE,SSID,SECURITY,BARS,SIGNAL" device wifi list 2>/dev/null | awk -F: '$2 != "" && !seen[$2]++ { print }')

ACTIVE_CONN=""
NET_ITEMS=""

while IFS=: read -r in_use ssid security bars signal; do
    [ -z "$ssid" ] && continue
    sec_label="Open"
    [ -n "$security" ] && [ "$security" != "--" ] && sec_label="$security"

    if [ "$in_use" = "*" ]; then
        ACTIVE_CONN="$ssid"
        NET_ITEMS="${NET_ITEMS}󰤨  $ssid ($L_CONNECTED) │ $signal% ($bars) │ $sec_label\n"
    else
        # Icono segun senal
        if [ "$signal" -ge 75 ]; then
            icon="󰤨"
        elif [ "$signal" -ge 50 ]; then
            icon="󰤥"
        elif [ "$signal" -ge 25 ]; then
            icon="󰤢"
        else
            icon="󰤟"
        fi
        [ "$sec_label" != "Open" ] && icon="${icon}"
        NET_ITEMS="${NET_ITEMS}${icon}  $ssid │ $signal% ($bars) │ $sec_label\n"
    fi
done <<< "$RAW_NETWORKS"

# Cabecera de acciones
HEADER="$TOGGLE_TEXT\n󰑐  Rescan [action:rescan]\n󰒓  nm-connection-editor [action:manager]\n󱛂  $L_CONNECT (Hidden SSID) [action:hidden]\n────────────────────────────────────────"

MENU_CONTENT=$(echo -e "${HEADER}\n${NET_ITEMS}")

CHOSEN=$(echo -e "$MENU_CONTENT" | rofi-themed -dmenu -i -p "$L_TITLE" -theme "$THEME_FILE" -m "$ACTIVE_MON")

[ -z "$CHOSEN" ] && exit 0
[[ "$CHOSEN" =~ ^─ ]] && exit 0

case "$CHOSEN" in
    *"[action:off]"*|*"Desactivar Wi-Fi"*|*"Disable"*)
        nmcli radio wifi off
        notify "$L_WIFI: Off"
        exit 0
        ;;
    *"[action:on]"*|*"Activar Wi-Fi"*|*"Enable"*)
        nmcli radio wifi on
        notify "$L_WIFI: On"
        exit 0
        ;;
    *"[action:rescan]"*|*"Escanear redes"*|*"Rescan"*)
        nmcli device wifi rescan 2>/dev/null || true
        sleep 1.5
        exec "$0"
        ;;
    *"[action:manager]"*|*"Abrir Administrador"*|*"nm-connection-editor"*)
        nm-connection-editor &
        exit 0
        ;;
    *"[action:hidden]"*|*"red oculta"*|*"Hidden"*)
        HIDDEN_SSID=$(rofi-themed -dmenu -p "SSID" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        [ -z "$HIDDEN_SSID" ] && exit 0
        HIDDEN_PASS=$(rofi-themed -dmenu -password -p "$L_PASS ($HIDDEN_SSID)" -theme "$THEME_FILE" -m "$ACTIVE_MON")
        if [ -n "$HIDDEN_PASS" ]; then
            nmcli dev wifi connect "$HIDDEN_SSID" password "$HIDDEN_PASS" hidden yes
        else
            nmcli dev wifi connect "$HIDDEN_SSID" hidden yes
        fi
        exit 0
        ;;
esac

# Extraer el SSID seleccionado
SELECTED_SSID=$(echo "$CHOSEN" | awk -F'│' '{print $1}' | sed -E 's/^[󰤨󰤥󰤢󰤟󰖩󰖪* ]+//' | sed -E 's/ \([^)]+\)$//' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')

[ -z "$SELECTED_SSID" ] && exit 0

# Si es la red activa, ofrecer desconectar u olvidar
if [ "$SELECTED_SSID" = "$ACTIVE_CONN" ]; then
    ACTION=$(echo -e "󰅖  $L_DISCONNECT: $SELECTED_SSID [action:disconnect]\n󰆴  Forget [action:forget]\n󰅁  $L_BACK [action:back]" | rofi-themed -dmenu -i -p "$SELECTED_SSID" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    case "$ACTION" in
        *"[action:disconnect]"*|*"Desconectar"*|*"Disconnect"*)
            nmcli connection down id "$SELECTED_SSID" 2>/dev/null || nmcli device disconnect wlan0 2>/dev/null
            notify "$L_DISCONNECT: $SELECTED_SSID"
            ;;
        *"[action:forget]"*|*"Olvidar"*|*"Forget"*)
            nmcli connection delete id "$SELECTED_SSID" 2>/dev/null
            notify "Forget: $SELECTED_SSID"
            ;;
    esac
    exit 0
fi

# Verificar si la conexion ya existe en el sistema
if nmcli -t -f NAME connection show | grep -Fxq "$SELECTED_SSID"; then
    notify "$L_CONNECT: $SELECTED_SSID..."
    if nmcli connection up id "$SELECTED_SSID"; then
        notify "$L_CONNECTED: $SELECTED_SSID"
    else
        notify "Error connecting: $SELECTED_SSID"
    fi
    exit 0
fi

# Red sin guardar: verificar si es abierta o protegida
SEC_TYPE=$(nmcli -t -f SSID,SECURITY device wifi list 2>/dev/null | awk -F: -v target="$SELECTED_SSID" '$1 == target { print $2; exit }')

if [ -z "$SEC_TYPE" ] || [ "$SEC_TYPE" = "--" ]; then
    notify "$L_CONNECT: $SELECTED_SSID..."
    if nmcli device wifi connect "$SELECTED_SSID"; then
        notify "$L_CONNECTED: $SELECTED_SSID"
    else
        notify "Error: $SELECTED_SSID"
    fi
else
    PASS=$(rofi-themed -dmenu -password -p "$L_PASS ($SELECTED_SSID)" -theme "$THEME_FILE" -m "$ACTIVE_MON")
    [ -z "$PASS" ] && exit 0
    notify "$L_CONNECT: $SELECTED_SSID..."
    if nmcli device wifi connect "$SELECTED_SSID" password "$PASS"; then
        notify "$L_CONNECTED: $SELECTED_SSID"
    else
        notify "Error: $SELECTED_SSID"
    fi
fi
