#!/usr/bin/env bash
export PATH="$HOME/.local/bin:$PATH"

# gpu-selector: Interactive GPU switcher for Hyprland (Rofi + Dynamic Island)

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -e "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
if [ -z "$WAYLAND_DISPLAY" ]; then
    WL_DISP=$(ls "$XDG_RUNTIME_DIR"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | grep -v 'awww' | head -n1)
    [ -n "$WL_DISP" ] && export WAYLAND_DISPLAY="$(basename "$WL_DISP")"
fi
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    HYPR_SIG=$(ls -t "$XDG_RUNTIME_DIR/hypr/" 2>/dev/null | head -n1)
    [ -n "$HYPR_SIG" ] && export HYPRLAND_INSTANCE_SIGNATURE="$HYPR_SIG"
fi

FORCE_ROFI=0
for arg in "$@"; do
    case "$arg" in
        --rofi|-r) FORCE_ROFI=1 ;;
    esac
done

ACTIVE_MON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .name' 2>/dev/null | head -n1)
[ -n "$ACTIVE_MON" ] || ACTIVE_MON="eDP-1"

# If Quickshell is active and not forced into Rofi, open the GPU tab in Settings
if [ "$FORCE_ROFI" -eq 0 ] && "$HOME/.local/bin/island-running" >/dev/null 2>&1; then
    quickshell ipc -p "$HOME/.config/quickshell/waybar-island/shell.qml" --any-display call island openHyprland "$ACTIVE_MON" >/dev/null 2>&1
    exit 0
fi

# Fallback: Rofi interactive menu
CURRENT_MODE=$(gpu-profile get 2>/dev/null || echo "hybrid")
STATUS_JSON=$(gpu-profile status --json 2>/dev/null || true)
IGPU_NAME=$(echo "$STATUS_JSON" | jq -r '.igpu_name // "Integrated"' 2>/dev/null)
DGPU_NAME=$(echo "$STATUS_JSON" | jq -r '.dgpu_name // "Dedicated"' 2>/dev/null)

L_PROFILE=$(rhythm-i18n hypr_gpu_profile "Graphics Profile")
L_HYBRID=$(rhythm-i18n hypr_gpu_hybrid "Hybrid")
L_INTEGRATED=$(rhythm-i18n hypr_gpu_integrated "Integrated")
L_DEDICATED=$(rhythm-i18n hypr_gpu_dedicated "Dedicated")

OPT_HYBRID="󰢮  $L_HYBRID (Auto)        - $IGPU_NAME desktop + $DGPU_NAME on-demand [action:hybrid]"
OPT_INTEGRATED="󰌢  $L_INTEGRATED Only      - $IGPU_NAME only (Power saving) [action:integrated]"
OPT_DEDICATED="󰢮  $L_DEDICATED Only       - $DGPU_NAME primary (Maximum performance) [action:dedicated]"

case "$CURRENT_MODE" in
    integrated) OPT_INTEGRATED="✓ $OPT_INTEGRATED" ;;
    dedicated)  OPT_DEDICATED="✓ $OPT_DEDICATED" ;;
    *)          OPT_HYBRID="✓ $OPT_HYBRID" ;;
esac

MENU_ITEMS="${OPT_HYBRID}\n${OPT_INTEGRATED}\n${OPT_DEDICATED}"

THEME_FILE="$HOME/.config/rofi/settings.rasi"
ROFI_ARGS=(-dmenu -i -p "󰢮 $L_PROFILE")
[ -f "$THEME_FILE" ] && ROFI_ARGS+=(-theme "$THEME_FILE")
[ -n "$ACTIVE_MON" ] && ROFI_ARGS+=(-m "$ACTIVE_MON")

CHOSEN=$(echo -e "$MENU_ITEMS" | rofi-themed "${ROFI_ARGS[@]}")
[ -z "$CHOSEN" ] && exit 0

case "$CHOSEN" in
    *"[action:integrated]"*|*Integrated*|*Integrad*) gpu-profile set integrated ;;
    *"[action:dedicated]"*|*Dedicated*|*Dedicad*)   gpu-profile set dedicated ;;
    *"[action:hybrid]"*|*Hybrid*|*Híbrid*|*Hibrid*) gpu-profile set hybrid ;;
esac
