#!/bin/bash
# toggle-noise-suppression: Toggle PipeWire noise cancelling (rnnoise/deepfilter)

MODULE_NAME="libpipewire-module-filter-chain"
SINK_NAME="noise_cancel_source"

is_active() {
    pactl list modules short 2>/dev/null | grep -q "$MODULE_NAME" || \
    pw-cli list-objects 2>/dev/null | grep -q "$SINK_NAME"
}

enable_noise() {
    # If already running, do nothing
    if is_active; then
        echo "on"
        return 0
    fi
    
    # Try loading filter chain via pactl or systemd service
    if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files | grep -q "noise-suppression"; then
        systemctl --user start noise-suppression 2>/dev/null || true
    fi
    echo "on"
}

disable_noise() {
    if command -v systemctl >/dev/null 2>&1 && systemctl --user list-unit-files | grep -q "noise-suppression"; then
        systemctl --user stop noise-suppression 2>/dev/null || true
    fi
    echo "off"
}

notify() {
    local title body
    title=$(rhythm-i18n "notif_noise_title" "Noise Suppression" 2>/dev/null || echo "Noise Suppression")
    if [ "$1" = "on" ]; then
        body=$(rhythm-i18n "notif_noise_enabled" "Microphone filter active" 2>/dev/null || echo "Microphone filter active")
    else
        body=$(rhythm-i18n "notif_noise_disabled" "Microphone filter inactive" 2>/dev/null || echo "Microphone filter inactive")
    fi
    notify-send -a "Noise Suppression" -i "audio-input-microphone" "$title" "$body" 2>/dev/null || true
}

case "${1:-toggle}" in
    status)
        if is_active; then echo "on"; else echo "off"; fi
        ;;
    on)
        enable_noise
        notify "on"
        ;;
    off)
        disable_noise
        notify "off"
        ;;
    toggle|*)
        if is_active; then
            disable_noise
            notify "off"
        else
            enable_noise
            notify "on"
        fi
        ;;
esac
