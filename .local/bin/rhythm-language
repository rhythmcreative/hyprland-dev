#!/usr/bin/env bash
# rhythm-language: Manage active language for Hyprland, Quickshell and user environment
# Fully compatible with Omarchy's language architecture.

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rhythm"
LANG_FILE="$CONFIG_DIR/language"
LOCALES_JSON="${RHYTHM_LOCALES_JSON:-$CONFIG_DIR/i18n/locales.json}"
SESSION_ENV="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm/env.d/50-rhythm-language"
ENV_LOCALE="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/10-locale.conf"

generator="rhythm-locale-generate"

known_language() {
    [ -f "$LOCALES_JSON" ] && jq -e --arg code "$1" 'has($code)' "$LOCALES_JSON" >/dev/null 2>&1
}

current_language() {
    local code=""
    if [[ -f "$LANG_FILE" ]]; then
        code=$(head -n 1 "$LANG_FILE" | tr -d '[:space:]')
    fi
    if [[ -n "$code" ]] && known_language "$code"; then
        echo "$code"
    else
        echo "es"
    fi
}

locale_for() {
    local code="$1"
    if [ -f "$LOCALES_JSON" ]; then
        jq -r --arg code "$code" '.[$code].locale // empty' "$LOCALES_JSON"
    fi
}

name_for() {
    local code="$1"
    if [ -f "$LOCALES_JSON" ]; then
        jq -r --arg code "$code" '.[$code].name // empty' "$LOCALES_JSON"
    fi
}

flag_for() {
    local code="$1"
    if [ -f "$LOCALES_JSON" ]; then
        jq -r --arg code "$code" '.[$code].flag // "🌐"' "$LOCALES_JSON"
    fi
}

list_languages() {
    if [ -f "$LOCALES_JSON" ]; then
        jq -r '
            to_entries
            | map({code: .key, name: .value.name, englishName: .value.englishName, flag: .value.flag, locale: .value.locale})
            | sort_by(if .code == "es" then "0" elif .code == "en" then "1" else .englishName end)
            | .[]
            | [.name, .code, .englishName, .flag, .locale] | @tsv
        ' "$LOCALES_JSON"
    fi
}

locale_generated() {
    local want available
    want=$(echo "$1" | tr -cd 'a-zA-Z0-9' | tr '[:upper:]' '[:lower:]')
    available=" $(locale -a 2>/dev/null | tr -cd 'a-zA-Z0-9\n' | tr '[:upper:]' '[:lower:]' | tr '\n' ' ') "
    [[ $available == *" $want "* ]]
}

generate_locale() {
    local code="$1" locale="$2"
    locale_generated "$locale" && return 0

    local base=${locale%.UTF-8}
    sudo localedef -i "$base" -f UTF-8 "$locale" >/dev/null 2>&1 || "$generator" "$code" || true
}

apply_session_locale() {
    local locale="$1"
    mkdir -p "$(dirname "$SESSION_ENV")"
    printf '# The session language, set by rhythm-language\nexport LANG=%s\nexport LC_MESSAGES=%s\nexport LANGUAGE=%s\n' "$locale" "$locale" "$locale" > "$SESSION_ENV"

    mkdir -p "$(dirname "$ENV_LOCALE")"
    printf 'LANG="%s"\nLC_MESSAGES="%s"\nLANGUAGE="%s"\n' "$locale" "$locale" "$locale" > "$ENV_LOCALE"

    # Update systemd-localed if available
    command -v localectl >/dev/null 2>&1 && localectl set-locale "LANG=$locale" "LC_MESSAGES=$locale" >/dev/null 2>&1 || true

    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl setenv LANG "$locale" >/dev/null 2>&1 || true
        hyprctl setenv LC_MESSAGES "$locale" >/dev/null 2>&1 || true
        hyprctl setenv LANGUAGE "$locale" >/dev/null 2>&1 || true
        hyprctl eval "hl.env(\"LANG\", \"$locale\", true)" >/dev/null 2>&1 || true
        hyprctl eval "hl.env(\"LC_MESSAGES\", \"$locale\", true)" >/dev/null 2>&1 || true
        hyprctl eval "hl.env(\"LANGUAGE\", \"$locale\", true)" >/dev/null 2>&1 || true
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user import-environment LANG LC_MESSAGES LANGUAGE >/dev/null 2>&1 || true
    fi
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd LANG LC_MESSAGES LANGUAGE >/dev/null 2>&1 || true
    fi
}

notify_quickshell() {
    local code="$1"
    local qs_path="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/waybar-island/shell.qml"
    quickshell ipc -p "$qs_path" --any-display call island reloadLanguage "" >/dev/null 2>&1 || true
    quickshell ipc -p "$qs_path" --any-display call island refreshLanguages "" >/dev/null 2>&1 || true
    quickshell ipc -p "$qs_path" --any-display call language set "$code" >/dev/null 2>&1 || true
}

set_language() {
    local code="$1"
    if ! known_language "$code"; then
        local found
        found=$(jq -r --arg l "$code" 'to_entries[] | select(.value.locale == $l or .value.locale == ($l + ".UTF-8")) | .key' "$LOCALES_JSON" 2>/dev/null | head -n 1)
        if [ -n "$found" ]; then
            code="$found"
        else
            local short=${code%%_*}
            if known_language "$short"; then
                code="$short"
            fi
        fi
    fi

    if ! known_language "$code"; then
        echo "Usage: rhythm-language [<code>|set <code>|list|locale [<code>]|toggle]" >&2
        echo "Unknown language code: $code" >&2
        echo "Run 'rhythm-language list' to see available codes." >&2
        exit 1
    fi

    local locale name flag
    locale=$(locale_for "$code")
    name=$(name_for "$code")
    flag=$(flag_for "$code")

    mkdir -p "$CONFIG_DIR"
    echo "$code" > "$LANG_FILE"

    # Also keep omarchy compatibility path
    mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
    echo "$code" > "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/language"

    apply_session_locale "$locale"
    notify_quickshell "$code"

    # Auto-switch keyboard layout to matching language if configured
    local kb_map=""
    case "$code" in
        es|es-ES|es-MX|latam|ca) kb_map="es" ;;
        en|en-US|en-GB|id|ms|fil|sw) kb_map="us" ;;
        de) kb_map="de" ;;
        fr) kb_map="fr" ;;
        it) kb_map="it" ;;
        pt|pt-BR) kb_map="pt" ;;
        ru) kb_map="ru" ;;
        ja) kb_map="jp" ;;
        zh-CN|cmn) kb_map="cn" ;;
        zh-TW) kb_map="tw" ;;
        ko) kb_map="kr" ;;
        tr) kb_map="tr" ;;
        pl) kb_map="pl" ;;
        nl) kb_map="nl" ;;
        sv) kb_map="se" ;;
        no) kb_map="no" ;;
        da) kb_map="dk" ;;
        fi) kb_map="fi" ;;
        el) kb_map="gr" ;;
        cs) kb_map="cz" ;;
        ro) kb_map="ro" ;;
        hu) kb_map="hu" ;;
        uk) kb_map="ua" ;;
        he) kb_map="il" ;;
        bg) kb_map="bg" ;;
        sk) kb_map="sk" ;;
        hr) kb_map="hr" ;;
        sl) kb_map="si" ;;
        et) kb_map="ee" ;;
        lv) kb_map="lv" ;;
        lt) kb_map="lt" ;;
        th) kb_map="th" ;;
        vi) kb_map="vn" ;;
        hi) kb_map="in" ;;
        bn) kb_map="bd" ;;
        ur) kb_map="pk" ;;
        fa) kb_map="ir" ;;
        is) kb_map="is" ;;
        ga) kb_map="ie" ;;
        uz) kb_map="uz" ;;
        si|ta) kb_map="lk" ;;
        ar) kb_map="ara" ;;
        *) kb_map="" ;;
    esac
    if [ -n "$kb_map" ] && [ -x "$HOME/.local/bin/notch-language-helper" ]; then
        "$HOME/.local/bin/notch-language-helper" switch "$kb_map" >/dev/null 2>&1 || true
    fi

    generate_locale "$code" "$locale"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Language" -i "preferences-desktop-locale" "Language Changed" "Switched to $flag $name ($locale)" -t 2500 2>/dev/null || true
    fi
    echo "Switched language to: $flag $name ($code, $locale)"
}

toggle_language() {
    local curr
    curr=$(current_language)
    if [ "$curr" = "es" ]; then
        set_language "en"
    else
        set_language "es"
    fi
}

case "${1:-}" in
    "")
        current_language
        ;;
    list)
        list_languages
        ;;
    locale)
        code=${2:-$(current_language)}
        if ! known_language "$code"; then
            echo "Unknown language code: $code" >&2
            exit 1
        fi
        locale_for "$code"
        ;;
    set)
        set_language "${2:-}"
        ;;
    toggle)
        toggle_language
        ;;
    *)
        set_language "$1"
        ;;
esac
